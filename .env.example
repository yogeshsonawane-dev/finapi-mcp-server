# Copy to .env and fill in. All values are optional; the server adjusts
# its behavior based on what is set. Never commit .env.

# --- Server ---
# MCP_PORT=8004

# --- Google OAuth (required to log users in via Google) ---
# GOOGLE_CLIENT_ID=123456789.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# MCP_PUBLIC_URL=http://localhost:8004

# --- Per-user API key resolution (FinAPI internal endpoint) ---
# FINAPI_SUBSCRIPTION_API_URL=https://api.finapi.upvaly.com/api/v1/mcp-subscription-key
# FINAPI_SUBSCRIPTION_API_KEY=<shared secret between FinAPI and this server>
# FINAPI_SUBSCRIPTION_API_HEADER=X-API-Key
# FINAPI_SUBSCRIPTION_CACHE_TTL=300
# FINAPI_SUBSCRIPTION_NEGATIVE_CACHE_TTL=60
# FINAPI_SUBSCRIPTION_API_TIMEOUT=5

# --- Direct API key (use this instead of OAuth; skips Google login) ---
# FINAPI_API_KEY=your-finapi-api-key